{
    "layer": "top", // Waybar at top layer
        "position": "top", // Waybar position (top|bottom|left|right)
                           // "width": 1280, // Waybar width
                           // Choose the order of the modules
        "modules-left": ["custom/arch", "hyprland/workspaces"],
        "modules-center": [],
        "modules-right": ["wlr/taskbar", "pulseaudio", "backlight", "battery", "clock"],
        "custom/arch": {
            "format": "  ",
            "tooltip": false,
            "on-click": ". $HOME/.config/rofi/applets/bin/powermenu.sh"
        },
        "hyprland/workspaces": {
            "disable-scroll": true,
            "format": " {icon} ",
            "format-icons": {
                "default": "",
            },
        },
        "wlr/taskbar": {
            "format": "{icon}",
            "icon-size": 12,
            "icon-theme": "Numix-Circle",
            "tooltip-format": "{title}",
            "on-click": "activate",
            "on-click-middle": "close",
            "grouping": "true",
            "ignore-list": [
                "kitty"
            ],
            "app_ids-mapping": {
                "firefoxdeveloperedition": "firefox-developer-edition"
            },
            "rewrite": {
                "Firefox Web Browser": "Firefox",
                "Foot Server": "Terminal"
            }
        },
        "clock": {
            "timezone": "Asia/Shanghai",
            "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
            "format-alt": " {:%d/%m/%Y}",
            "format": " {:%H:%M}"
        },
        "backlight": {
            "device": "light",
            "format": "{icon}",
            "format-icons": ["", "", "", "", "", "", "", "", ""],
            "on-click": ". $HOME/.config/rofi/applets/bin/brightness.sh"
        },
        "battery": {
            "states": {
                "warning": 30,
                "critical": 15
            },
            "format": "{icon}",
            "format-charging": "",
            "format-plugged": "",
            "format-alt": "{icon}",
            "on-click": ". $HOME/.config/rofi/applets/bin/battery.sh",
            "format-icons": ["", "",  "", "", "", "", "", "", "", "", "", ""]
        },
        "pulseaudio": {
            // "scroll-step": 1, // %, can be a float
            "format": "{volume}% {icon}",
            "format-bluetooth": "{volume}% {icon}",
            "format-muted": "",
            "format-icons": {
              "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
              "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
              "headphone": "",
              "hands-free": "",
              "headset": "",
              "phone": "",
              "phone-muted": "",
              "portable": "",
              "car": "",
              "default": ["", ""]
            },
            "scroll-step": 1,
            "on-click": ". $HOME/.config/rofi/applets/bin/volume.sh"
        }
}
